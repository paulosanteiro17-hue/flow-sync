# ---------------------------------------------------------------------------
# FlowSync environment. Copy to `.env` and adjust. Never commit a real secret.
# ---------------------------------------------------------------------------

# --- Infrastructure (docker compose) ---------------------------------------
POSTGRES_USER=flowsync
POSTGRES_PASSWORD=flowsync
POSTGRES_DB=flowsync
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000

# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public URL of the API, used to build attachment download links.
API_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://flowsync:flowsync@localhost:5432/flowsync?schema=public
# Separate database used by the backend integration suite.
DATABASE_URL_TEST=postgresql://flowsync:flowsync@localhost:5432/flowsync_test?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters in production.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

# `lax` when the web app and API share a site, `none` when they are on split origins
# (which also requires COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# Redis powers presence, realtime sequencing, rate limiting and WebSocket scaling.
# Disable it to run a single API instance with in-memory equivalents.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- Storage ---------------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR; `s3` targets any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/uploads
UPLOAD_MAX_BYTES=10485760

# S3_BUCKET=flowsync-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Behaviour -------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Serves the OpenAPI explorer at /api/docs. Defaults to on outside production.
# A portfolio deployment usually wants it on; a real one usually does not.
API_DOCS_ENABLED=true

# One-click demo entry point on the landing page.
DEMO_ENABLED=true
DEMO_EMAIL=emma.carter@northstarlabs.io
DEMO_PASSWORD=DemoFlow2024!

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
