{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json", "isolatedModules": true }]
  },
  "setupFiles": ["<rootDir>/test/load-env.ts"],
  "testTimeout": 30000,
  "maxWorkers": 1,
  "forceExit": true
}
